---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: 'OpenGov Treasury',
    description: 'Submit a Polkadot OpenGov treasury proposal for review.',
    tableOfContents: false,
    editUrl: 'https://github.com/dablockdao/polkadot-ecosystem/tree/main/dot-atlas/src/pages/governance/proposal-intake.astro',
    lastUpdated: new Date(),
  }}
>
  <div class="proposal-intake not-content">
    <iframe src="https://cryptpad.fr/form/#/2/form/view/He6J1TOYTxEfEFvElmckEW9N1BxcTRR7Sje68B4y+Ow/embed/"></iframe>
    <p class="proposal-intake-fallback">
      <a
        href="https://cryptpad.fr/form/#/2/form/view/He6J1TOYTxEfEFvElmckEW9N1BxcTRR7Sje68B4y+Ow/"
        target="_blank"
        rel="noopener noreferrer"
        class="proposal-intake-fallback-link"
        aria-label="Open the OpenGov Treasury proposal form in a new tab"
      >
        <span>Click here if the form is unable to load.</span>
        <span class="proposal-intake-fallback-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"/>
            <polyline points="8 7 17 7 17 16"/>
          </svg>
        </span>
      </a>
    </p>
  </div>
</StarlightPage>

<!-- Hide the Starlight page heading on this page only; the CryptPad form
     supplies its own title inside the iframe. Title still lives in the
     <head>/SEO for the browser tab. -->
<style is:global>
  main h1 { display: none; }
</style>

<style>
  .proposal-intake {
    width: 100%;
    margin: 0 auto;
    padding: 0;
  }

  .proposal-intake-fallback {
    margin: 16px 0 0;
    text-align: center;
    font-size: 14px;
    color: var(--sl-color-text);
    opacity: 0.85;
  }

  .proposal-intake-fallback-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    border-radius: 999px;
    padding: 4px 4px 4px 12px;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .proposal-intake-fallback-link:hover,
  .proposal-intake-fallback-link:focus-visible {
    color: var(--sl-color-accent);
    background: var(--link-hover-bg, rgba(122, 111, 95, 0.08));
    outline: none;
  }

  .proposal-intake-fallback-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--sl-color-muted);
    border-radius: 50%;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }

  .proposal-intake-fallback-link:hover .proposal-intake-fallback-arrow,
  .proposal-intake-fallback-link:focus-visible .proposal-intake-fallback-arrow {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-bg);
    transform: translate(2px, -2px);
  }

  .proposal-intake iframe {
    display: block;
    width: 100%;
    min-height: 1200px;
    height: calc(100vh - 180px);
    max-height: 1600px;
    border: 1px solid var(--sl-color-muted);
    border-radius: 10px;
    background: var(--sl-color-bg-soft);
  }

  @media (max-width: 768px) {
    .proposal-intake iframe {
      min-height: 900px;
      border-radius: 8px;
    }
  }
</style>

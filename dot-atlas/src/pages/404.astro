---
const title = 'Page Not Found — Polkadot Ecosystem';
const description = 'The page you are looking for does not exist or has been moved.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      * { box-sizing: border-box; margin: 0; }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background: #0d0f14;
        color: #e4e6eb;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem;
      }
      h1 { font-size: 5rem; line-height: 1; color: #8b5cf6; margin-bottom: 0.5rem; }
      .lead { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.25rem; }
      p { opacity: 0.7; margin-bottom: 1.5rem; }
      nav { display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; }
      a {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        background: #1a1d24;
        color: #e4e6eb;
        text-decoration: none;
        font-weight: 500;
        border: 1px solid #2a2d35;
      }
      a:hover { background: #8b5cf6; color: #fff; border-color: #8b5cf6; }
    </style>
  </head>
  <body>
    <h1>404</h1>
    <p class="lead">Page not found</p>
    <p>The page you're looking for doesn't exist or has been moved.</p>
    <nav>
      <a href="/">Home</a>
      <a href="/tools/">Tools</a>
      <a href="/dapps/">Dapps</a>
      <a href="/resources/">Resources</a>
      <a href="/club/">Community</a>
    </nav>
  </body>
</html>
